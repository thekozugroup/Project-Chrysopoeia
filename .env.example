# Copy to .env next to docker-compose.yml and adjust. Every line is optional.

# Files are written as this user and group. Use the owner of your media
# (run `id` on the host). Unraid: 99 and 100.
PUID=1000
PGID=1000

# Time zone for logs and the "active hours" schedule.
TZ=Etc/UTC

# Host folder with your media (mounted at /media in the container).
MEDIA_PATH=./media

# Optional host folder on a fast disk for in-progress files (mounted at
# /temp). Also uncomment the /temp line in docker-compose.yml.
TEMP_PATH=./temp

# Host port for the web UI.
PORT=8080

# Hardware acceleration on first start (changeable later in the app):
#   auto          best GPU encoder that passes a test encode, else the CPU
#   cpu           never use a GPU
#   nvenc         NVIDIA
#   qsv           Intel Quick Sync
#   vaapi         Intel or AMD
#   amf           AMD's proprietary driver stack (not in the Docker image;
#                 AMD GPUs use vaapi there)
#   rkmpp         Rockchip boards such as the RK3588
#   v4l2m2m       Raspberry Pi 4 and other V4L2 encoders
#   videotoolbox  Apple, only when running natively on macOS (not in Docker)
HW_ACCEL=auto

# Jobs at once. Empty = automatic, based on CPU cores, memory and GPU.
MAX_JOBS=

# Folders inside the container to add as libraries on first start,
# comma-separated. Empty = add them in the app.
LIBRARIES=

# NVIDIA: GPUs are chosen in docker-compose.nvidia.yml (count or device_ids),
# not with NVIDIA_VISIBLE_DEVICES, which Docker overrides there.

# Run a locally built image (make docker) instead of the published one.
# CHRYSOPOEIA_IMAGE=chrysopoeia:dev
