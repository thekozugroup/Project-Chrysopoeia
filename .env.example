# Copy to .env next to docker-compose.yml and adjust. Every line is optional.

# Files are written as this user and group. Use the owner of your media
# (run `id` on the host, or `stat -c '%u %g' /path/to/media`). Unraid: 99 and 100.
PUID=1000
PGID=1000

# Permissions for what Chrysopoeia creates itself (work files, folders in an
# output folder): 002 lets the group edit them, 022 does not. A converted file
# keeps the permissions of the original it replaces.
UMASK=002

# Time zone (IANA name such as Europe/London or America/New_York) for the
# "When to convert" schedule in Settings > Processing. Log lines are in UTC.
TZ=Etc/UTC

# Host folder with your media (mounted at /media in the container).
MEDIA_PATH=./media

# Optional host folder on a fast disk for in-progress files (mounted at
# /temp). Also uncomment the /temp line in docker-compose.yml.
TEMP_PATH=./temp

# Host port for the web UI.
PORT=8080

# Hardware acceleration:
#   auto          best GPU encoder that passes a test encode, else the CPU
#   cpu           never use a GPU
#   nvenc         NVIDIA
#   qsv           Intel Quick Sync
#   vaapi         Intel or AMD
#   amf           AMD's proprietary driver stack (not in the Docker image;
#                 AMD GPUs use vaapi there)
#   rkmpp         Rockchip boards such as the RK3588
#   v4l2m2m       Raspberry Pi 4 and other V4L2 encoders
#   videotoolbox  Apple, only when running natively on macOS (not in Docker)
# A GPU choice uses only that kind of GPU. Files go to the CPU when that GPU
# is missing or cannot encode the chosen format, so check Settings > Hardware:
# under Details, each format that passed its test encode shows Works.
# Applied on the first start, and again on the next start whenever you change
# it here. In between, the choice under Settings > Hardware in the app is kept;
# auto never overrides that choice.
HW_ACCEL=auto

# Files converted at once, 1 to 32. Empty = automatic, based on CPU cores,
# memory and GPU. A number here replaces the automatic count while "Files at
# once" is Automatic in Settings > Processing; a number chosen there wins.
MAX_JOBS=

# Folders inside the container to add as libraries on first start,
# comma-separated, e.g. /media/Movies,/media/TV. They start with the "Save
# space" goal and begin converting at once. Empty = choose folder and goal in
# the app's first-run screens.
LIBRARIES=

# Only behind a reverse proxy: the domain name(s) you open Chrysopoeia at,
# comma-separated, e.g. transcode.example.com. The server's IP address,
# localhost and local names (nas, nas.local, nas.lan, *.ts.net) always work;
# any other name gets "doesn't answer to the address" until it is listed.
# * allows every name (only do that if something else checks who connects).
# The proxy must also pass on the Host header (plain nginx:
# proxy_set_header Host $http_host; Apache: ProxyPreserveHost On).
ALLOWED_HOSTS=

# NVIDIA: GPUs are chosen in docker-compose.nvidia.yml (count or device_ids),
# not with NVIDIA_VISIBLE_DEVICES, which Docker overrides there.

# Run a locally built image (make docker) instead of the published one.
# CHRYSOPOEIA_IMAGE=chrysopoeia:dev
